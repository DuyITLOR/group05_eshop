<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="HW05 AUTH_HEAVY SPIKE - Users Me" enabled="true">
      <stringProp name="TestPlan.comments">Production SPIKE plan for GET /api/users/me. It requires disposable-runtime preflight and external hw05.auth_token. No execution evidence or performance conclusion is implied.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="baseUrl" elementType="Argument">
            <stringProp name="Argument.name">baseUrl</stringProp>
            <stringProp name="Argument.value">${__P(baseUrl,http://localhost:3000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <kg.apc.jmeter.threads.UltimateThreadGroup guiclass="kg.apc.jmeter.threads.UltimateThreadGroupGui" testclass="kg.apc.jmeter.threads.UltimateThreadGroup" testname="SPIKE - Users Me - Aggregate 5 to 25 to 5 VUs" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
        <collectionProp name="ultimatethreadgroupdata">
          <collectionProp name="baseline-cohort">
            <stringProp name="baseline-start-threads">5</stringProp>
            <stringProp name="baseline-initial-delay">0</stringProp>
            <stringProp name="baseline-startup-time">1</stringProp>
            <stringProp name="baseline-hold-load">66</stringProp>
            <stringProp name="baseline-shutdown-time">1</stringProp>
          </collectionProp>
          <collectionProp name="spike-cohort">
            <stringProp name="spike-start-threads">20</stringProp>
            <stringProp name="spike-initial-delay">20</stringProp>
            <stringProp name="spike-startup-time">3</stringProp>
            <stringProp name="spike-hold-load">20</stringProp>
            <stringProp name="spike-shutdown-time">5</stringProp>
          </collectionProp>
        </collectionProp>
      </kg.apc.jmeter.threads.UltimateThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV - AUTH_HEAVY Identity Assertions" enabled="true">
          <stringProp name="delimiter">,</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="filename">test-data/auth-heavy-users-me.csv</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">true</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
          <boolProp name="stopThread">false</boolProp>
          <stringProp name="variableNames">expected_user_id,expected_email,expected_name,auth_case,iteration_key</stringProp>
        </CSVDataSet>
        <hashTree/>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header - External Bearer Token" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="Authorization" elementType="Header">
              <stringProp name="Header.name">Authorization</stringProp>
              <stringProp name="Header.value">Bearer ${__P(hw05.auth_token,)}</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Fail Closed - Require External Auth Token" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
def token = props.get('hw05.auth_token')
if (token == null || token.toString().trim().isEmpty()) {
    throw new IllegalStateException('Missing required JMeter property hw05.auth_token. Run the mandatory disposable-runtime preflight and supply an external -q properties file.')
}
]]></stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think Time - 250 to 500 ms" enabled="true">
          <stringProp name="ConstantTimer.delay">250</stringProp>
          <stringProp name="RandomTimer.range">250</stringProp>
        </UniformRandomTimer>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/users/me" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain"></stringProp>
          <stringProp name="HTTPSampler.port"></stringProp>
          <stringProp name="HTTPSampler.protocol"></stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">${baseUrl}/api/users/me</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout"></stringProp>
          <stringProp name="HTTPSampler.response_timeout"></stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="expected-http-200">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Expected HTTP 200 for the approved authenticated identity path.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert Authenticated Identity JSON Contract" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper

try {
    def body = new JsonSlurper().parseText(prev.getResponseDataAsString())
    if (!(body instanceof Map)) throw new IllegalStateException('Response must be a JSON object')
    if (body.id == null || body.id.toString() != vars.get('expected_user_id')) throw new IllegalStateException('id does not match approved expected_user_id')
    if (body.email == null || body.email.toString() != vars.get('expected_email')) throw new IllegalStateException('email does not match approved expected_email')
    if (body.name == null || body.name.toString() != vars.get('expected_name')) throw new IllegalStateException('name does not match approved expected_name')
    if (body.containsKey('error')) throw new IllegalStateException('Response must not contain top-level error')
} catch (Exception error) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Authenticated identity assertion failed: ' + error.getMessage())
}
]]></stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
        <kg.apc.jmeter.vizualizers.CorrectedResultCollector guiclass="kg.apc.jmeter.vizualizers.ResponseTimesOverTimeGui" testclass="kg.apc.jmeter.vizualizers.CorrectedResultCollector" testname="jp@gc - Response Times Over Time" enabled="true">
          <boolProp name="include_sample_labels">true</boolProp>
          <boolProp name="exclude_controllers">false</boolProp>
          <stringProp name="include_sample_labels_regex"></stringProp>
          <stringProp name="exclude_sample_labels_regex"></stringProp>
          <stringProp name="startTime"></stringProp>
          <stringProp name="endTime"></stringProp>
          <stringProp name="granularity">1000</stringProp>
        </kg.apc.jmeter.vizualizers.CorrectedResultCollector>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
