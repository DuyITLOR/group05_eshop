{
  "info": {
    "_postman_id": "23127107-mini-users-me-collection",
    "name": "Mini API Testing - Lấy profile hiện tại - 23127107",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Thiết lập - đăng nhập tài khoản test đã seed",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Đăng nhập thiết lập trả về 200', () => { pm.response.to.have.status(200); });",
              "const loginBody = pm.response.json();",
              "pm.test('Đăng nhập thiết lập trả về JWT', () => { pm.expect(loginBody.token).to.be.a('string').and.not.empty; });",
              "pm.environment.set('authToken', loginBody.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@eshop.com\",\n  \"password\": \"Test1234!\"\n}"
        },
        "url": "{{baseUrl}}/api/login"
      },
      "response": []
    },
    {
      "name": "GET /api/users/me - chạy theo dữ liệu",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const mode = pm.iterationData.get('auth_mode');",
              "pm.request.headers.upsert({ key: 'X-Student-Id', value: pm.environment.get('studentId') });",
              "if (mode === 'valid') {",
              "  pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${pm.environment.get('authToken')}` });",
              "} else if (mode === 'malformed') {",
              "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer not-a-jwt' });",
              "} else if (mode === 'empty_bearer') {",
              "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer' });",
              "} else {",
              "  pm.request.headers.remove('Authorization');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const row = pm.iterationData.toObject();",
              "const expectedStatus = Number(row.expected_status);",
              "const maxResponseTime = Number(row.expected_max_response_time_ms);",
              "let body;",
              "",
              "pm.test(`[${row.case_id}] status là ${expectedStatus}`, () => {",
              "  pm.response.to.have.status(expectedStatus);",
              "});",
              "",
              "pm.test(`[${row.case_id}] Content-Type là JSON`, () => {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "pm.test(`[${row.case_id}] response time nằm trong local guardrail`, () => {",
              "  pm.expect(pm.response.responseTime).to.be.at.most(maxResponseTime);",
              "});",
              "",
              "pm.test(`[${row.case_id}] response shape là đúng`, () => {",
              "  body = pm.response.json();",
              "  if (expectedStatus === 200) {",
              "    pm.expect(body).to.be.an('object');",
              "    pm.expect(body).to.include.keys('id', 'name', 'email', 'role');",
              "    pm.expect(body.id).to.be.a('number');",
              "    pm.expect(body.name).to.be.a('string').and.not.empty;",
              "    pm.expect(body.email).to.eql(row.expected_email);",
              "    pm.expect(body.role).to.be.a('string').and.not.empty;",
              "  } else {",
              "    pm.expect(body).to.be.an('object');",
              "    pm.expect(body.error).to.be.a('string').and.not.empty;",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users/me"
      },
      "response": []
    }
  ]
}
