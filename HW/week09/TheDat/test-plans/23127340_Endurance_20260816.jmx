            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JWT and user ID must exist">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">if (!vars.get(&apos;token&apos;) || vars.get(&apos;token&apos;) == &apos;NOT_FOUND&apos;) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;JWT token was not extracted&apos;)
}
if (!vars.get(&apos;userId&apos;) || vars.get(&apos;userId&apos;) == &apos;NOT_FOUND&apos;) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;User ID was not extracted&apos;)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
