            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Cart contains selected product">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">try {
    def cart = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    def expectedId = vars.get(&apos;productId&apos;)
    def found = cart instanceof List &amp;&amp; cart.any { String.valueOf(it.id) == expectedId }
    if (!found) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&quot;Cart does not contain product ID ${expectedId}&quot;)
    }
} catch (Exception error) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Invalid cart JSON: ${error.message}&quot;)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
