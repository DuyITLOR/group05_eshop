            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Verify created order">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">try {
    def order = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    def problems = []
    if (String.valueOf(order.id) != vars.get(&apos;orderId&apos;)) problems &lt;&lt; &apos;id&apos;
    if (String.valueOf(order.user_id) != vars.get(&apos;userId&apos;)) problems &lt;&lt; &apos;user_id&apos;
    if (new BigDecimal(String.valueOf(order.total_amount)).compareTo(new BigDecimal(vars.get(&apos;totalAmount&apos;))) != 0) problems &lt;&lt; &apos;total_amount&apos;
    if (String.valueOf(order.shipping_address) != vars.get(&apos;shippingAddress&apos;)) problems &lt;&lt; &apos;shipping_address&apos;
    if (String.valueOf(order.status) != &apos;pending&apos;) problems &lt;&lt; &apos;status&apos;
    if (!problems.isEmpty()) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&quot;Order fields do not match: ${problems.join(&apos;, &apos;)}&quot;)
    }
} catch (Exception error) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Invalid order JSON: ${error.message}&quot;)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>
