            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Products HTTP 200">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">Products must return HTTP 200</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Products list and selected product must be valid">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">try {
    def products = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    if (!(products instanceof List) || products.isEmpty()) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;Products response is not a non-empty JSON array&apos;)
        return
    }
    def product = products.find { String.valueOf(it.id) == vars.get(&apos;productId&apos;) }
    if (product == null) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&quot;Product ID ${vars.get(&apos;productId&apos;)} from CSV was not found&quot;)
        return
    }
    def actualName = String.valueOf(product.name)
    def actualPrice = new BigDecimal(String.valueOf(product.price)).stripTrailingZeros().toPlainString()
    def expectedPrice = new BigDecimal(vars.get(&apos;price&apos;)).stripTrailingZeros().toPlainString()
    if (actualName != vars.get(&apos;productName&apos;) || actualPrice != expectedPrice) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&quot;CSV product data does not match API for ID ${vars.get(&apos;productId&apos;)}&quot;)
        return
    }
    vars.put(&apos;selectedProductName&apos;, actualName)
    vars.put(&apos;selectedProductPrice&apos;, actualPrice)
} catch (Exception error) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Invalid products JSON: ${error.message}&quot;)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
